# Host port 5433 avoids clashing with a local Postgres on 5432.
DATABASE_URL="postgresql://certiflow:certiflow_dev@localhost:5433/certiflow"
REDIS_URL="redis://localhost:6379"
PORT=4000
SESSION_SECRET="ae9b39d5fb844e136e694ad17a71b2729364024c3488e18a"

QUORUM=2
BIG_BATCH=100
SLA_HOURS=48
CACHE_TTL_SECONDS=60
MAX_JOB_ATTEMPTS=5

# Run `npm run keygen` and paste the line it prints here.
# Without it the API signs with a temporary key that is lost on restart (development only).
ED25519_PRIVATE_KEY_PEM=
